# ============================================================
# DATABASE — Supabase PostgreSQL
# ============================================================
# Connection pooler URL (for Prisma in serverless environments)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL (required by Prisma for migrations)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ============================================================
# SUPABASE — Authentication & Storage
# ============================================================
# Found in: Supabase Dashboard > Project Settings > API
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ============================================================
# AI — OpenAI & Anthropic
# ============================================================
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-..."

# Anthropic (Claude fallback): https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."

# ============================================================
# STRIPE — Payments & Subscriptions
# ============================================================
# Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY="sk_live_..."

# Stripe Dashboard > Developers > Webhooks > Signing secret
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Dashboard > Products — ID of the Premium subscription price
STRIPE_PREMIUM_PRICE_ID="price_..."

# ============================================================
# AUTH — JWT
# ============================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-jwt-key-min-32-chars"

# Supabase JWT Secret — used to verify Supabase access tokens server-side
# Found in: Supabase Dashboard > Project Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# URL of this API in production
NEXTAUTH_URL="https://api.permis-ai.ch"

# ============================================================
# CACHE — Upstash Redis (Rate limiting & session cache)
# ============================================================
# Upstash Dashboard: https://console.upstash.com/
UPSTASH_REDIS_REST_URL="https://[database-name].upstash.io"
UPSTASH_REDIS_REST_TOKEN="AX..."

# ============================================================
# APP
# ============================================================
# Public URL of the API (used in CORS headers, emails, etc.)
NEXT_PUBLIC_APP_URL="https://api.permis-ai.ch"

# Node environment
NODE_ENV="production"
