{
  "expo": {
    "name": "Permis AI",
    "slug": "permis-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "permisai",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F0F0F",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F0F"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ch.permisai.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Cette application n'utilise pas la caméra.",
        "NSMicrophoneUsageDescription": "Cette application n'utilise pas le microphone.",
        "CFBundleLocalizations": ["fr", "de", "it"],
        "CFBundleDevelopmentRegion": "fr"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F0F0F"
      },
      "package": "ch.permisai.app",
      "versionCode": 1,
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F0F0F",
          "image": "./assets/splash.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-font",
        {
          "fonts": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    },
    "owner": "permis-ai"
  }
}
