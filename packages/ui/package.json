{
  "name": "@permis-ai/ui",
  "version": "1.0.0",
  "private": true,
  "description": "Shared UI component library for Permis AI (web dashboard)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./components/*": {
      "types": "./src/components/*.tsx",
      "default": "./src/components/*.tsx"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "build": "tsc"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^20.12.12",
    "typescript": "^5.4.5"
  },
  "keywords": [
    "permis-ai",
    "ui",
    "components",
    "react"
  ]
}
